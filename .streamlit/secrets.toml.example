# Streamlit Secrets Configuration Template
# Copy this file to .streamlit/secrets.toml and fill in your actual values
# For Streamlit Cloud, add these as secrets in the app settings

[mlflow]
# Databricks Community Edition MLflow Tracking URI
# Format: https://<workspace-id>.cloud.databricks.com
tracking_uri = "https://your-workspace.cloud.databricks.com"

# Databricks Personal Access Token
# Get this from: Databricks Workspace -> User Settings -> Access Tokens
databricks_token = "your-databricks-token-here"

[model]
# Path to your model file (relative to app root or absolute path)
# For Streamlit Cloud, you may need to host the model file separately
path = "best68.pt"

# Alternative: Use environment variables instead
# MODEL_PATH=best68.pt
# MLFLOW_TRACKING_URI=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=your-token-here

